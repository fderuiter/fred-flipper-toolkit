      "private": [
        "cd /tmp/fred-eval/pilot2/6e263f94b3/ws && cat > application.fam <<'E'\nApp(\n    appid=\"tally_counter\",\n    name=\"Tally Counter\",\n    apptype=FlipperAppType.EXTERNAL,\n    entry_point=\"tally_counter_app\",\n    requires=[\"gui\"],\n    stack_size=1 * 1024,\n    fap_category=\"Tools\",\n    fap_version=\"1.0\",\n)\nE\ncat > tally_logic.h <<'E'\n#pragma once\n#include <stdint.h>\n\n#define TALLY_MAX 999999U\n\nstatic inline uint32_t tally_increment(uint32_t count) {\n    return (count >= TALLY_MAX) ? TALLY_MAX : count + 1;\n}\n\nstatic inline uint32_t tally_decrement(uint32_t count) {\n    return (count == 0) ? 0 : count - 1;\n}\nE\ncat > tally_counter.c <<'E'\n#include <furi.h>\n#include <gui/gui.h>\n#include <input/input.h>\n#include <stdio.h>\n\n#include \"tally_logic.h\"\n\ntypedef struct {\n    Gui* gui;\n    ViewPort* view_port;\n    FuriMessageQueue* queue;\n    FuriMutex* mutex;\n    uint32_t count; // guarded by mutex\n} TallyApp;\n\nstatic void tally_draw_callback(Canvas* canvas, void* ctx) {\n    TallyApp* app = ctx;\n    uint32_t count = 0;\n    if(furi_mutex_acquire(app->mutex, 25) != FuriStatusOk) return;\n    count = app->count;\n    furi_mutex_release(app->mutex);\n\n    char text[12];\n    snprintf(text, sizeof(text), \"%lu\", (unsigned long)count);\n\n    canvas_clear(canvas);\n    canvas_set_color(canvas, ColorBlack);\n    canvas_set_font(canvas, FontBigNumbers);\n    canvas_draw_str_aligned(canvas, 64, 32, AlignCenter, AlignCenter, text);\n    canvas_set_font(canvas, FontSecondary);\n    canvas_draw_str_aligned(canvas, 64, 62, AlignCenter, AlignBottom, \"Hold OK: reset\");\n}\n\n// GUI thread: only forward the event.\nstatic void tally_input_callback(InputEvent* event, void* ctx) {\n    TallyApp* app = ctx;\n    // Dropping a count press when full is acceptable; Back is handled below.\n    furi_message_queue_put(app->queue, event, 0);\n}\n\nint32_t tally_counter_app(void* p) {\n    UNUSED(p);\n    TallyApp* app = malloc(sizeof(TallyApp));\n    app->count = 0;\n    app->queue = furi_message_queue_alloc(8, sizeof(InputEvent));\n    app->mutex = furi_mutex_alloc(FuriMutexTypeNormal);\n    app->view_port = view_port_alloc();\n    view_port_draw_callback_set(app->view_port, tally_draw_callback, app);\n    view_port_input_callback_set(app->view_port, tally_input_callback, app);\n    app->gui = furi_record_open(RECORD_GUI);\n    gui_add_view_port(app->gui, app->view_port, GuiLayerFullscreen);\n\n    InputEvent event;\n    bool running = true;\n    while(running) {\n        if(furi_message_queue_get(app->queue, &event, FuriWaitForever) != FuriStatusOk) continue;\n\n        if(event.key == InputKeyBack) {\n            if(event.type == InputTypeShort) running = false;\n            continue;\n        }\n\n        bool changed = false;\n        furi_mutex_acquire(app->mutex, FuriWaitForever);\n        if(event.type == InputTypeShort && event.key == InputKeyUp) {\n            app->count = tally_increment(app->count);\n            changed = true;\n        } else if(event.type == InputTypeShort && event.key == InputKeyDown) {\n            app->count = tally_decrement(app->count);\n            changed = true;\n        } else if(event.type == InputTypeLong && event.key == InputKeyOk) {\n            app->count = 0;\n            changed = true;\n        }\n        furi_mutex_release(app->mutex);\n        if(changed) view_port_update(app->view_port);\n    }\n\n    gui_remove_view_port(app->gui, app->view_port);\n    furi_record_close(RECORD_GUI);\n    view_port_free(app->view_port);\n    furi_message_queue_free(app->queue);\n    furi_mutex_free(app->mutex);\n    free(app);\n    return 0;\n}\nE\ncat > test_logic.c <<'E'\n#include <assert.h>\n#include \"tally_logic.h\"\nint main(void) {\n    assert(tally_decrement(0) == 0);\n    assert(tally_decrement(5) == 4);\n    assert(tally_increment(0) == 1);\n    assert(tally_increment(TALLY_MAX) == TALLY_MAX);\n    return 0;\n}\nE\ngcc -Wall -Wextra -o /tmp/claude-0/t test_logic.c && /tmp/claude-0/t; echo exit=$?",
