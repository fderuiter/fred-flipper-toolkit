        "cd /tmp/fred-eval/pilot2/f4a982967a/ws && mkdir -p tally_counter test && cat > tally_counter/application.fam <<'E'\nApp(\n    appid=\"tally_counter\",\n    name=\"Tally Counter\",\n    apptype=FlipperAppType.EXTERNAL,\n    entry_point=\"tally_counter_app\",\n    requires=[\"gui\"],\n    stack_size=2 * 1024,\n    fap_category=\"Tools\",\n)\nE\ncat > tally_counter/tally.h <<'E'\n#pragma once\n#include <stdint.h>\n\n// Pure counter logic, no Furi dependencies so it can be host-tested.\n// Capped at 6 digits so the count always fits the 128 px wide screen in FontBigNumbers.\n#define TALLY_MAX 999999U\n\nstatic inline uint32_t tally_inc(uint32_t v) {\n    return v < TALLY_MAX ? v + 1 : TALLY_MAX;\n}\n\nstatic inline uint32_t tally_dec(uint32_t v) {\n    return v > 0 ? v - 1 : 0;\n}\nE\ncat > tally_counter/tally_counter.c <<'E'\n#include \"tally.h\"\n\n#include <furi.h>\n#include <gui/gui.h>\n#include <input/input.h>\n#include <stdio.h>\n\ntypedef struct {\n    Gui* gui;\n    ViewPort* view_port;\n    FuriMutex* mutex; // guards count; held only for short reads/writes\n    FuriEventFlag* exit_flag; // set by input callback; cannot be dropped like a queue item\n    uint32_t count;\n} TallyApp;\n\n#define TALLY_FLAG_EXIT (1U << 0)\n\n// GUI thread. Short snapshot of the model, then draw.\nstatic void tally_draw_callback(Canvas* canvas, void* context) {\n    TallyApp* app = context;\n\n    furi_check(furi_mutex_acquire(app->mutex, FuriWaitForever) == FuriStatusOk);\n    uint32_t count = app->count;\n    furi_mutex_release(app->mutex);\n\n    char buf[16];\n    snprintf(buf, sizeof(buf), \"%lu\", (unsigned long)count);\n\n    canvas_clear(canvas);\n    canvas_set_color(canvas, ColorBlack);\n    canvas_set_font(canvas, FontSecondary);\n    canvas_draw_str_aligned(canvas, 64, 2, AlignCenter, AlignTop, \"Tally\");\n    canvas_set_font(canvas, FontBigNumbers);\n    canvas_draw_str_aligned(canvas, 64, 32, AlignCenter, AlignCenter, buf);\n}\n\n// GUI thread. Short work only: update count under mutex or raise the exit flag.\nstatic void tally_input_callback(InputEvent* event, void* context) {\n    TallyApp* app = context;\n\n    if(event->key == InputKeyBack) {\n        if(event->type == InputTypeShort) {\n            furi_event_flag_set(app->exit_flag, TALLY_FLAG_EXIT);\n        }\n        return;\n    }\n\n    bool changed = false;\n    furi_check(furi_mutex_acquire(app->mutex, FuriWaitForever) == FuriStatusOk);\n    if(event->key == InputKeyUp && event->type == InputTypeShort) {\n        app->count = tally_inc(app->count);\n        changed = true;\n    } else if(event->key == InputKeyDown && event->type == InputTypeShort) {\n        app->count = tally_dec(app->count);\n        changed = true;\n    } else if(event->key == InputKeyOk && event->type == InputTypeLong) {\n        app->count = 0;\n        changed = true;\n    }\n    furi_mutex_release(app->mutex);\n\n    if(changed) view_port_update(app->view_port);\n}\n\nint32_t tally_counter_app(void* p) {\n    UNUSED(p);\n\n    TallyApp* app = malloc(sizeof(TallyApp));\n    app->count = 0;\n    app->mutex = furi_mutex_alloc(FuriMutexTypeNormal);\n    app->exit_flag = furi_event_flag_alloc();\n    app->view_port = view_port_alloc();\n    view_port_draw_callback_set(app->view_port, tally_draw_callback, app);\n    view_port_input_callback_set(app->view_port, tally_input_callback, app);\n\n    app->gui = furi_record_open(RECORD_GUI);\n    gui_add_view_port(app->gui, app->view_port, GuiLayerFullscreen);\n\n    furi_event_flag_wait(\n        app->exit_flag, TALLY_FLAG_EXIT, FuriFlagWaitAny | FuriFlagNoClear, FuriWaitForever);\n\n    // Detach the ViewPort first so no draw/input callback can run past this point.\n    gui_remove_view_port(app->gui, app->view_port);\n    furi_record_close(RECORD_GUI);\n    view_port_free(app->view_port);\n    furi_event_flag_free(app->exit_flag);\n    furi_mutex_free(app->mutex);\n    free(app);\n\n    return 0;\n}\nE\ncat > test/test_tally.c <<'E'\n#include \"../tally_counter/tally.h\"\n#include <assert.h>\n#include <stdio.h>\n\nint main(void) {\n    assert(tally_dec(0) == 0);\n    assert(tally_dec(1) == 0);\n    assert(tally_inc(0) == 1);\n    assert(tally_inc(TALLY_MAX) == TALLY_MAX);\n    assert(tally_inc(TALLY_MAX - 1) == TALLY_MAX);\n    uint32_t v = 0;\n    for(int i = 0; i < 5; i++) v = tally_inc(v);\n    for(int i = 0; i < 8; i++) v = tally_dec(v);\n    assert(v == 0);\n    puts(\"ok\");\n    return 0;\n}\nE\ngcc -Wall -Wextra -o /tmp/claude-0/t test/test_tally.c && /tmp/claude-0/t; which ufbt"
